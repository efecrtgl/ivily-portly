{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ivily Portly",
  "version": "../package.json",
  "identifier": "com.efecrtgl.ivilyportly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ivily Portly",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": true,
        "backgroundColor": "#0C0C0E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "efecrtgl",
    "homepage": "https://github.com/efecrtgl/ivily-portly",
    "copyright": "© 2026 efecrtgl",
    "category": "DeveloperTool",
    "shortDescription": "Port, process and dev server manager",
    "longDescription": "Ivily Portly is an open-source Windows utility for monitoring ports, inspecting the processes behind them and organizing local development servers.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Ivily Portly"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwOTM2QzYzQ0UxRDY2MEMKUldRTVpoM09ZMnlURUZPTG5HZXVZZFlJWENDTC9SOXpLcCtnNFo2M1ZDamZITnJYSUdFNDlRR0QK",
      "endpoints": ["https://github.com/efecrtgl/ivily-portly/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
